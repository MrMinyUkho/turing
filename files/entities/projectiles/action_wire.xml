<Entity name="circuit_wire_projectile">
    <VelocityComponent
        gravity_y="0"
        air_friction="0"
        terminal_velocity="600" >
    </VelocityComponent>

    <ProjectileComponent
        lifetime="60"
        speed_min="500"
        speed_max="500"
        damage="0"
        penetrate_entities="1"
        collide_with_world="1"
        on_death_explode="0" >
        <config_explosion
            never_cache="1"
            damage="0"
            explosion_radius="1" >
        </config_explosion>
    </ProjectileComponent>

    <!-- Вызывает логику подключения при столкновении или попадании -->
    <LuaComponent
        script_source_file="mods/turing/files/scripts/wire_tool.lua"
        execute_on_added="1"
        execute_every_n_frame="2" >
    </LuaComponent>

    <SpriteComponent 
        image_file="data/projectiles_gfx/spark_blue.xml"
        offset_x="4"
        offset_y="4"
        is_visual="1" >
    </SpriteComponent>
</Entity>