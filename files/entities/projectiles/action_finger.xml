<Entity name="circuit_finger_projectile">
    <VelocityComponent
        gravity_y="0"
        air_friction="0"
        terminal_velocity="1000" >
    </VelocityComponent>

    <ProjectileComponent
        lifetime="5"
        speed_min="800"
        speed_max="800"
        damage="0"
        penetrate_entities="1"
        collide_with_world="0"
        on_death_explode="0" >
        <config_explosion
            never_cache="1"
            damage="0"
            explosion_radius="1" >
        </config_explosion>
    </ProjectileComponent>

    <!-- Скрипт, срабатывающий сразу при рождении/первом кадре -->
    <LuaComponent
        script_source_file="mods/turing/files/scripts/finger_tool.lua"
        execute_on_added="1"
        execute_every_n_frame="-1" >
    </LuaComponent>

    <!-- Небольшой визуальный эффект искры/точки при клике -->
    <ParticleEmitterComponent
        emitted_material_name="spark"
        offset.x="0"
        offset.y="0"
        x_pos_offset_min="-2"
        y_pos_offset_min="-2"
        x_pos_offset_max="2"
        y_pos_offset_max="2"
        count_min="4"
        count_max="8"
        lifetime_min="0.1"
        lifetime_max="0.2"
        is_emitting="1" >
    </ParticleEmitterComponent>
</Entity>